generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  tokenExpiresAt    DateTime?

  @@map("auth_users")
}

model generators {
  id                                Int       @id @default(autoincrement())
  data_year                         Int?
  source_sheet                      String?   @db.VarChar(50)
  entity_id                         Int?
  entity_name                       String?   @db.VarChar(255)
  plant_id                          Int?
  plant_name                        String?   @db.VarChar(255)
  plant_state                       String?   @db.VarChar(2)
  county                            String?   @db.VarChar(100)
  balancing_authority_code          String?   @db.VarChar(20)
  sector                            String?   @db.VarChar(100)
  generator_id                      String?   @db.VarChar(50)
  unit_code                         String?   @db.VarChar(50)
  nameplate_capacity_mw             Decimal?  @db.Decimal(12, 3)
  net_summer_capacity_mw            Decimal?  @db.Decimal(12, 3)
  net_winter_capacity_mw            Decimal?  @db.Decimal(12, 3)
  nameplate_energy_capacity_mwh     String?   @db.VarChar(50)
  dc_net_capacity_mw                String?   @db.VarChar(50)
  technology                        String?   @db.VarChar(200)
  energy_source_code                String?   @db.VarChar(10)
  prime_mover_code                  String?   @db.VarChar(10)
  operating_month                   Int?
  operating_year                    Int?
  planned_operation_month           Int?
  planned_operation_year            Int?
  planned_retirement_month          String?   @db.VarChar(20)
  planned_retirement_year           String?   @db.VarChar(20)
  retirement_month                  Int?
  retirement_year                   Int?
  status                            String?   @db.VarChar(200)
  planned_derate_year               String?   @db.VarChar(20)
  planned_derate_month              String?   @db.VarChar(20)
  planned_derate_summer_capacity_mw String?   @db.VarChar(50)
  planned_uprate_year               String?   @db.VarChar(20)
  planned_uprate_month              String?   @db.VarChar(20)
  planned_uprate_summer_capacity_mw String?   @db.VarChar(50)
  latitude                          Decimal?  @db.Decimal(10, 6)
  longitude                         Decimal?  @db.Decimal(10, 6)
  created_at                        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([nameplate_capacity_mw], map: "idx_gen_capacity")
  @@index([energy_source_code, plant_state], map: "idx_gen_energy_source")
  @@index([entity_id, plant_state], map: "idx_gen_entity_state")
  @@index([source_sheet, status], map: "idx_gen_source_status")
  @@index([plant_state, technology], map: "idx_gen_state_tech")
  @@index([operating_year, technology], map: "idx_gen_year_tech")
  @@index([county], map: "ix_generators_county")
  @@index([data_year], map: "ix_generators_data_year")
  @@index([energy_source_code], map: "ix_generators_energy_source_code")
  @@index([entity_id], map: "ix_generators_entity_id")
  @@index([entity_name], map: "ix_generators_entity_name")
  @@index([id], map: "ix_generators_id")
  @@index([operating_year], map: "ix_generators_operating_year")
  @@index([plant_id], map: "ix_generators_plant_id")
  @@index([plant_name], map: "ix_generators_plant_name")
  @@index([plant_state], map: "ix_generators_plant_state")
  @@index([sector], map: "ix_generators_sector")
  @@index([source_sheet], map: "ix_generators_source_sheet")
  @@index([status], map: "ix_generators_status")
  @@index([technology], map: "ix_generators_technology")
}

model operational_data {
  id                                        Int        @id @default(autoincrement())
  data_year                                 Int?
  utility_number                            Int?
  utility_name                              String?    @db.VarChar(255)
  state                                     String?    @db.VarChar(2)
  ownership_type                            String?    @db.VarChar(100)
  nerc_region                               String?    @db.VarChar(20)
  summer_peak_demand_mw                     Decimal?   @db.Decimal(12, 2)
  winter_peak_demand_mw                     Decimal?   @db.Decimal(12, 2)
  net_generation_mwh                        Decimal?   @db.Decimal(15, 2)
  wholesale_power_purchases_mwh             Decimal?   @db.Decimal(15, 2)
  exchange_energy_received_mwh              Decimal?   @db.Decimal(15, 2)
  exchange_energy_delivered_mwh             Decimal?   @db.Decimal(15, 2)
  net_power_exchanged_mwh                   Decimal?   @db.Decimal(15, 2)
  wheeled_power_received_mwh                Decimal?   @db.Decimal(15, 2)
  wheeled_power_delivered_mwh               Decimal?   @db.Decimal(15, 2)
  net_wheeled_power_mwh                     Decimal?   @db.Decimal(15, 2)
  transmission_by_other_losses_mwh          Decimal?   @db.Decimal(15, 2)
  total_sources_mwh                         Decimal?   @db.Decimal(15, 2)
  sales_to_ultimate_customers_mwh           Decimal?   @db.Decimal(15, 2)
  sales_for_resale_mwh                      Decimal?   @db.Decimal(15, 2)
  furnished_without_charge_mwh              Decimal?   @db.Decimal(15, 2)
  consumed_by_respondent_without_charge_mwh Decimal?   @db.Decimal(15, 2)
  total_energy_losses_mwh                   Decimal?   @db.Decimal(15, 2)
  total_disposition_mwh                     Decimal?   @db.Decimal(15, 2)
  from_retail_sales_thousands               Decimal?   @db.Decimal(15, 2)
  from_delivery_customers_thousands         Decimal?   @db.Decimal(15, 2)
  from_sales_for_resale_thousands           Decimal?   @db.Decimal(15, 2)
  from_credits_or_adjustments_thousands     Decimal?   @db.Decimal(15, 2)
  from_transmission_thousands               Decimal?   @db.Decimal(15, 2)
  from_other_thousands                      Decimal?   @db.Decimal(15, 2)
  total_revenue_thousands                   Decimal?   @db.Decimal(15, 2)
  data_type                                 String?    @db.VarChar(50)
  created_at                                DateTime?  @default(now()) @db.Timestamptz(6)
  utilities                                 utilities? @relation(fields: [utility_number], references: [utility_number], onDelete: NoAction, onUpdate: NoAction)

  @@index([nerc_region], map: "idx_ops_nerc_region")
  @@index([state, ownership_type], map: "idx_ops_state_ownership")
  @@index([utility_number, state], map: "idx_ops_utility_state")
  @@index([data_year], map: "ix_operational_data_data_year")
  @@index([id], map: "ix_operational_data_id")
  @@index([nerc_region], map: "ix_operational_data_nerc_region")
  @@index([ownership_type], map: "ix_operational_data_ownership_type")
  @@index([state], map: "ix_operational_data_state")
  @@index([utility_name], map: "ix_operational_data_utility_name")
  @@index([utility_number], map: "ix_operational_data_utility_number")
}

model service_territories {
  id             Int        @id @default(autoincrement())
  data_year      Int?
  utility_number Int?
  utility_name   String?    @db.VarChar(255)
  short_form     String?    @db.VarChar(10)
  state          String?    @db.VarChar(2)
  county         String?    @db.VarChar(100)
  created_at     DateTime?  @default(now()) @db.Timestamptz(6)
  utilities      utilities? @relation(fields: [utility_number], references: [utility_number], onDelete: NoAction, onUpdate: NoAction)

  @@index([state, county], map: "idx_territory_state_county")
  @@index([utility_number, state], map: "idx_territory_utility_state")
  @@index([county], map: "ix_service_territories_county")
  @@index([data_year], map: "ix_service_territories_data_year")
  @@index([id], map: "ix_service_territories_id")
  @@index([state], map: "ix_service_territories_state")
  @@index([utility_name], map: "ix_service_territories_utility_name")
  @@index([utility_number], map: "ix_service_territories_utility_number")
}

model utilities {
  id                  Int                   @id @default(autoincrement())
  data_year           Int?
  utility_number      Int?                  @unique(map: "ix_utilities_utility_number")
  utility_name        String?               @db.VarChar(255)
  state               String?               @db.VarChar(2)
  ownership_type      String?               @db.VarChar(100)
  nerc_region         String?               @db.VarChar(20)
  tre                 String?               @db.VarChar(1)
  frcc                String?               @db.VarChar(1)
  mro                 String?               @db.VarChar(1)
  npcc                String?               @db.VarChar(1)
  rfc                 String?               @db.VarChar(1)
  serc                String?               @db.VarChar(1)
  spp                 String?               @db.VarChar(1)
  wecc                String?               @db.VarChar(1)
  caiso               String?               @db.VarChar(1)
  ercot               String?               @db.VarChar(1)
  pjm                 String?               @db.VarChar(1)
  nyiso               String?               @db.VarChar(1)
  spp_rto             String?               @db.VarChar(1)
  miso                String?               @db.VarChar(1)
  isone               String?               @db.VarChar(1)
  other_rto           String?               @db.VarChar(1)
  generation          String?               @db.VarChar(1)
  transmission        String?               @db.VarChar(1)
  buying_transmission String?               @db.VarChar(1)
  distribution        String?               @db.VarChar(1)
  buying_distribution String?               @db.VarChar(1)
  wholesale_marketing String?               @db.VarChar(1)
  retail_marketing    String?               @db.VarChar(1)
  bundled             String?               @db.VarChar(1)
  alt_fuel_vehicle    String?               @db.VarChar(1)
  alt_fuel_vehicle_2  String?               @db.VarChar(1)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  operational_data    operational_data[]
  service_territories service_territories[]
  utility_sales       utility_sales[]

  @@index([data_year], map: "ix_utilities_data_year")
  @@index([id], map: "ix_utilities_id")
  @@index([nerc_region], map: "ix_utilities_nerc_region")
  @@index([ownership_type], map: "ix_utilities_ownership_type")
  @@index([state], map: "ix_utilities_state")
  @@index([utility_name], map: "ix_utilities_utility_name")
}

model utility_sales {
  id                               Int        @id @default(autoincrement())
  data_year                        Int?
  utility_number                   Int?
  utility_name                     String?    @db.VarChar(255)
  part                             String?    @db.VarChar(1)
  service_type                     String?    @db.VarChar(50)
  data_type                        String?    @db.VarChar(50)
  state                            String?    @db.VarChar(2)
  ownership                        String?    @db.VarChar(100)
  ba_code                          String?    @db.VarChar(20)
  residential_revenue_thousands    Decimal?   @db.Decimal(15, 2)
  residential_sales_mwh            Decimal?   @db.Decimal(15, 2)
  residential_customers_count      Int?
  commercial_revenue_thousands     Decimal?   @db.Decimal(15, 2)
  commercial_sales_mwh             Decimal?   @db.Decimal(15, 2)
  commercial_customers_count       Int?
  industrial_revenue_thousands     Decimal?   @db.Decimal(15, 2)
  industrial_sales_mwh             Decimal?   @db.Decimal(15, 2)
  industrial_customers_count       Int?
  transportation_revenue_thousands Decimal?   @db.Decimal(15, 2)
  transportation_sales_mwh         Decimal?   @db.Decimal(15, 2)
  transportation_customers_count   Int?
  total_revenue_thousands          Decimal?   @db.Decimal(15, 2)
  total_sales_mwh                  Decimal?   @db.Decimal(15, 2)
  total_customers_count            Int?
  created_at                       DateTime?  @default(now()) @db.Timestamptz(6)
  utilities                        utilities? @relation(fields: [utility_number], references: [utility_number], onDelete: NoAction, onUpdate: NoAction)

  @@index([ownership, state], map: "idx_sales_ownership")
  @@index([state, service_type], map: "idx_sales_state_type")
  @@index([utility_number, state], map: "idx_sales_utility_state")
  @@index([data_year], map: "ix_utility_sales_data_year")
  @@index([id], map: "ix_utility_sales_id")
  @@index([ownership], map: "ix_utility_sales_ownership")
  @@index([state], map: "ix_utility_sales_state")
  @@index([utility_name], map: "ix_utility_sales_utility_name")
  @@index([utility_number], map: "ix_utility_sales_utility_number")
}
